{
  "name": "one-to-one-ui",
  "private": true,
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": "22.22.x",
    "npm": "11.11.x"
  },
  "scripts": {
    "build:css": "npm run build:css:core && npm run build:css:bundles",
    "build:css:core": "postcss src/main/resources/static/css/tailwind.css -o src/main/resources/static/css/app.css --env production",
    "build:css:bundles": "postcss \"src/main/resources/static/css/entries/*.css\" --dir src/main/resources/static/css/bundles --env production",
    "watch:css": "postcss src/main/resources/static/css/tailwind.css -o src/main/resources/static/css/app.css -w",
    "qa:simulate": "node tools/qa/run-site-simulation.mjs",
    "qa:simulate:standards": "node tools/qa/run-site-simulation.mjs --skip-workflows",
    "qa:simulate:ci": "node tools/qa/run-site-simulation.mjs --fail-on major",
    "qa:release": "node tools/qa/playwright-release-gate.mjs",
    "qa:login:roles": "node tools/qa/run-site-simulation.mjs --login-only --roles trainer,gym --fail-on major",
    "qa:login:trainer": "node tools/qa/run-site-simulation.mjs --login-only --roles trainer --fail-on major",
    "qa:login:gym": "node tools/qa/run-site-simulation.mjs --login-only --roles gym --fail-on major"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.0",
    "cssnano": "^7.1.9",
    "postcss": "^8.5.12",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.0",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "^3.4.19"
  }
}
