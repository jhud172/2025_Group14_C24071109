# Copy this file to `.env` for local overrides used by `./gradlew bootRun`.
# Do not commit real secrets.

# Public base URL used in emails and callback links.
APP_BASE_URL=http://localhost:8081

# AI assistant
OPENAI_API_KEY=
APP_AI_ENABLED=true
APP_AI_MODEL=gpt-4o-mini

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email delivery
APP_EMAIL_FROM=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# SMS / verification
APP_SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Optional local feature toggles
DEV_MODE=false
