{
  "name": "one-to-one-ui",
  "private": true,
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": "22.22.x",
    "npm": "11.11.x"
  },
  "scripts": {
    "build:css": "postcss src/main/resources/static/css/tailwind.css -o src/main/resources/static/css/app.css",
